<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DoorMan</AssemblyName>
    <RootNamespace>DoorMan</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Product>DoorMan</Product>
    <Description>Protege carpetas con contraseña desde el Explorador de archivos</Description>
    <Version>2.1.0</Version>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <!-- La extensión del Explorador tiene que ser de la arquitectura de Windows: la de este ejecutable. -->
    <ShellArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</ShellArch>
    <ShellArch Condition="'$(ShellArch)' == ''">x64</ShellArch>
    <ShellExtension>..\..\native\DoorManShell\bin\$(ShellArch)\DoorManShell.dll</ShellExtension>
    <!-- Paquete del menú de Windows 11 (DoorMan.msix y DoorMan.cer), generado antes de publicar. -->
    <ContextMenuPackageDir>..\..\native\DoorManShell\bin\msix\</ContextMenuPackageDir>
    <ApplicationIcon>..\..\icons\generados\lock_closed.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Los archivos marcadores (API Cloud Files) necesitan Windows 10 1709 o posterior. No se sube la
      versión de destino porque añadiría la proyección de WinRT (unos 25 MB) sin usarla.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Declaraciones de la API Cloud Files de Windows (NativeMethods.txt), generadas al compilar. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Lo que la instalación pone junto al ejecutable va DENTRO de él (recursos «Payload/…», ver Payload.cs): así
    basta con descargar un único DoorMan.exe y hacer doble clic. Son la extensión del Explorador, los iconos
    (icons\generados: carpetas bloqueadas y los de la aplicación y las opciones del menú) y el paquete del
    menú de Windows 11. En la carpeta de compilación también se copian sueltos, para depurar.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\icons\generados\*.ico" LogicalName="Payload/iconos/%(Filename)%(Extension)" />
    <None Include="..\..\icons\generados\*.ico" Link="iconos\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ShellExtension)')">
    <EmbeddedResource Include="$(ShellExtension)" LogicalName="Payload/DoorManShell.dll" />
    <None Include="$(ShellExtension)" Link="DoorManShell.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ContextMenuPackageDir)DoorMan.msix') And Exists('$(ContextMenuPackageDir)DoorMan.cer')">
    <EmbeddedResource Include="$(ContextMenuPackageDir)DoorMan.msix" LogicalName="Payload/DoorMan.msix" />
    <EmbeddedResource Include="$(ContextMenuPackageDir)DoorMan.cer" LogicalName="Payload/DoorMan.cer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoorMan.Tests" />
  </ItemGroup>

</Project>
