<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DoorMan</AssemblyName>
    <RootNamespace>DoorMan</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <SatelliteResourceLanguages>es</SatelliteResourceLanguages>
    <Product>DoorMan</Product>
    <Description>Protege carpetas con contraseña desde el Explorador de archivos</Description>
    <Version>2.0.0</Version>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <ShellExtension>..\..\native\DoorManShell\bin\DoorManShell.dll</ShellExtension>
    <ApplicationIcon>..\..\icons\generados\filled_locked.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Los archivos marcadores (API Cloud Files) necesitan Windows 10 1709 o posterior. No se sube la
      versión de destino porque añadiría la proyección de WinRT (unos 25 MB) sin usarla.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Declaraciones de la API Cloud Files de Windows (NativeMethods.txt), generadas al compilar. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <!--
    Iconos de carpeta (bloqueada/desbloqueada, vacía/con contenido): se instalan en «iconos».
    Son los de icons\generados (herramientas\generar-iconos.ps1), con todos los tamaños que usa Windows.
  -->
  <ItemGroup>
    <None Include="..\..\icons\generados\*.ico"
          Link="iconos\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- Extensión nativa del Explorador (native\DoorManShell\build.ps1): va junto al ejecutable. -->
  <ItemGroup Condition="Exists('$(ShellExtension)')">
    <None Include="$(ShellExtension)"
          Link="DoorManShell.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoorMan.Tests" />
  </ItemGroup>

</Project>
