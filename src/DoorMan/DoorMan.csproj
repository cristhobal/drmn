<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DoorMan</AssemblyName>
    <RootNamespace>DoorMan</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <!-- DoorMan's own texts are in Strings.cs; no satellite assemblies of the framework are needed. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Product>DoorMan</Product>
    <Description>Password-protect folders from File Explorer</Description>
    <Version>3.0.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The Explorer extension must match the architecture of Windows, which is the one of this executable. -->
    <ShellArch Condition="'$(RuntimeIdentifier)' == 'win-x86'">x86</ShellArch>
    <ShellArch Condition="'$(RuntimeIdentifier)' == 'win-arm64'">arm64</ShellArch>
    <ShellArch Condition="'$(ShellArch)' == ''">x64</ShellArch>
    <ShellExtension>..\..\native\DoorManShell\bin\$(ShellArch)\DoorManShell.dll</ShellExtension>
    <!--
      Windows 11 context menu package (DoorMan.msix and DoorMan.cer), built before publishing. Windows 11 only exists
      for x64 and arm64, so the x86 build has none.
    -->
    <ContextMenuPackageDir>..\..\native\DoorManShell\bin\msix\$(ShellArch)\</ContextMenuPackageDir>
    <ApplicationIcon>..\..\icons\generated\lock_closed.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!--
      Placeholder files (Cloud Files API) need Windows 10 1709 or later. The target version is not raised because it
      would add the WinRT projection (about 25 MB) without using it.
    -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <!-- Declarations of the Windows Cloud Files API (NativeMethods.txt), generated at build time. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.367" PrivateAssets="all" />
  </ItemGroup>

  <!--
    What the installation puts next to the executable goes INSIDE it (“Payload/…” resources, see Payload.cs), so a
    single DoorMan.exe is enough to download and double-click: the Explorer extension, the icons (icons\generated:
    locked folders, the app and the menu options) and the Windows 11 context menu package. They are also copied as
    loose files to the build folder, for debugging.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\icons\generated\*.ico" LogicalName="Payload/icons/%(Filename)%(Extension)" />
    <None Include="..\..\icons\generated\*.ico" Link="icons\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ShellExtension)')">
    <EmbeddedResource Include="$(ShellExtension)" LogicalName="Payload/DoorManShell.dll" />
    <None Include="$(ShellExtension)" Link="DoorManShell.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(ContextMenuPackageDir)DoorMan.msix') And Exists('$(ContextMenuPackageDir)DoorMan.cer')">
    <EmbeddedResource Include="$(ContextMenuPackageDir)DoorMan.msix" LogicalName="Payload/DoorMan.msix" />
    <EmbeddedResource Include="$(ContextMenuPackageDir)DoorMan.cer" LogicalName="Payload/DoorMan.cer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoorMan.Tests" />
  </ItemGroup>

</Project>
